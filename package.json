{
  "name": "bira",
  "private": true,
  "version": "0.0.0",
  "workspaces": [
    "web",
    "server",
    "mcp"
  ],
  "scripts": {
    "dev": "concurrently -n server,web -c blue,magenta \"npm:dev:server\" \"npm:dev:web\"",
    "dev:web": "npm run dev --workspace=web",
    "dev:server": "npm run dev --workspace=server",
    "dev:mcp": "npm run dev --workspace=@bira/mcp",
    "build": "npm run build --workspace=web && npm run build --workspace=server && npm run build --workspace=@bira/mcp",
    "build:web": "npm run build --workspace=web",
    "build:server": "npm run build --workspace=server",
    "build:mcp": "npm run build --workspace=@bira/mcp",
    "lint": "npm run lint --workspaces --if-present",
    "db:up": "npm run db:up --workspace=server",
    "db:reset": "npm run db:reset --workspace=server",
    "db:down": "npm run db:down --workspace=server",
    "seed": "npm run seed --workspace=server"
  },
  "devDependencies": {
    "concurrently": "^9.2.1"
  }
}
