{
  "name": "bira",
  "private": true,
  "version": "0.0.0",
  "workspaces": [
    "web",
    "server"
  ],
  "scripts": {
    "dev": "npm run dev --workspace=web",
    "dev:web": "npm run dev --workspace=web",
    "dev:server": "npm run dev --workspace=server",
    "build": "npm run build --workspace=web && npm run build --workspace=server",
    "build:web": "npm run build --workspace=web",
    "build:server": "npm run build --workspace=server",
    "lint": "npm run lint --workspaces --if-present",
    "db:up": "npm run db:up --workspace=server",
    "db:reset": "npm run db:reset --workspace=server",
    "db:down": "npm run db:down --workspace=server",
    "seed": "npm run seed --workspace=server"
  }
}
