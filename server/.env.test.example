# Copy to .env.test before running tests.
# Tests use a SEPARATE Postgres database (`bira_test`) on the same host
# Postgres container as dev (port 5433). Run `npm run db:test:reset` once
# before the first test run (and after any migration change) to drop +
# recreate + migrate the test DB.
#
# NOTE: docker-compose.yml sets POSTGRES_USER=postgres / PASSWORD=postgres,
# so the connection string below uses those creds (not bira/bira). If you
# point at a different Postgres, adjust accordingly.
NODE_ENV=test
PORT=5002

DATABASE_URL=postgres://postgres:postgres@localhost:5433/bira_test

JWT_SECRET=test-access-secret
JWT_REFRESH_SECRET=test-refresh-secret
JWT_EXPIRE=1d
JWT_REFRESH_EXPIRE=14d

LOG_LEVEL=error
